{
  "expo": {
    "name": "GoalHubApp",
    "slug": "GoalHubApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/goalhub-logo.png",
    "scheme": "goalhubapp",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F5F5F5",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#091413",
        "foregroundImage": "./assets/images/goalhub-logo.png",
        "monochromeImage": "./assets/images/goalhub-logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ernitaa.GoalHubApp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/goalhub-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/goalhub-logo.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#091413",
          "dark": {
            "backgroundColor": "#091413"
          }
        }
      ],
      "expo-video",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      "./plugins/with-system-bars",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
